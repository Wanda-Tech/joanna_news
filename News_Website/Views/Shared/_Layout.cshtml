<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - News_Website</title>
    <link href="~/webfonts" rel="stylesheet" />
    <link href="~/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/News_Website.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg shadow-sm navbar-light" style="z-index: 10;">
            <div class="container-fluid bg-light fw-bold text-primary">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">News_Website</a>
                
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-around" id="navbarSupportedContent">
                    <ul class="navbar-nav me-mb-2 mb-lg-0 flex-grow-1 ms-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Trendy News</a>
                        </li>
                        <li class="nav-item dropdown position-relative">
                            <a class="nav-link text-dark dropdown-toggle" asp-area="" asp-controller="Home" asp-action="Index">Categories</a>
                            <ul class="dropdown-menu shadow">
                                <li>
                                    <a class="dropdown-item" href="#">Politics</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#">Tech</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#">Health</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#">Sport</a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Articles</a>
                        </li>
                        <li class="nav-item  dropdown position-relative">
                            <a class="nav-link text-dark  dropdown-toggle" asp-area="" asp-controller="Home" asp-action="Index">Us</a>
                            <ul class="dropdown-menu shadow">
                                <li>
                                    <a class="dropdown-item" href="#">About Us</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#">Contact US</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#">Privacy</a>
                                </li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">User</a>
                        </li>
                    </ul>
                    <!-- search form-->
                    <form class="d-lg-flex d-none" role="search">
                        <input class="form-control me-2 search-box" type="search" placeholder="Search" aria-label="Search" />
                        <button class="btn" type="submit">
                            <i class="fas fa-search"></i>
                            </button>
                    </form>
                    <!-- icon for small screen-->
                    <div class="d-lg-none">
                        <a href="#" class="nav-link"><i class="fas fa-search"></i></a>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-light text-black shadow-sm">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5>News_Website</h5>
                    <p>
                        Your trustest source of daily news, and stories from around the globe 
                    </p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Quick links</h6>
                    <ul class="list-unstyled">
                        <li> <a href="#" class="footer-link">Home</a></li>
                        <li> <a href="#" class="footer-link">News</a></li>
                        <li> <a href="#" class="footer-link">About</a></li>
                        <li> <a href="#" class="footer-link">Contact</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Follow Us</h6>
                    <a href="#" class="me-2 text-black"><i class="fab fa-facebook"></i></a>
                    <a href="#" class="me-2 text-black"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="me-2 text-black"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="me-2 text-black"><i class="fab fa-youtube"></i></a>
                    <a href="#" class="me-2 text-black"><i class="fab fa-tiktok"></i></a>
                </div>
            </div>
            <hr />
            <div class="text-center pb-3">
                <small>
                    &copy; 2025 - News_Website. All Right Reserved - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </small>
            </div>
             </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
